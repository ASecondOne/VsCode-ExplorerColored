{
  "name": "src-folder-colors",
  "displayName": "Src Folder Colors",
  "description": "Color Explorer names by their containing folder, with distinct parent and child colors.",
  "version": "0.2.0",
  "publisher": "local-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/ASecondOne/VsCode-ExplorerColored.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "test": "node --test test/colors.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "srcFolderColors.refresh",
        "title": "Src Folder Colors: Refresh"
      }
    ],
    "configuration": {
      "title": "Src Folder Colors",
      "properties": {
        "srcFolderColors.root": {
          "type": "string",
          "default": "src",
          "scope": "resource",
          "description": "Directory relative to each workspace folder, e.g. src or packages/app/src. Absolute paths and .. segments are not supported."
        },
        "srcFolderColors.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Color Explorer names by their containing folder, with subfolders always different from their parent."
        }
      }
    },
    "colors": [
      {
        "id": "srcFolderColors.color1",
        "description": "Folder palette color 1.",
        "defaults": {
          "dark": "#89B4FA",
          "light": "#285EA8",
          "highContrast": "#89B4FA",
          "highContrastLight": "#285EA8"
        }
      },
      {
        "id": "srcFolderColors.color2",
        "description": "Folder palette color 2.",
        "defaults": {
          "dark": "#A6E3A1",
          "light": "#397539",
          "highContrast": "#A6E3A1",
          "highContrastLight": "#397539"
        }
      },
      {
